# SynapseNest production env template — copy to .env.prod and fill secrets.
# Do NOT commit real secrets.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# SpaceXAI (xAI) — server-side only. Leave empty to use mounted Grok CLI auth if present.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Nest contract token (must match edge / callers). Set in real .env.prod.
NEST_CONTRACT_TOKEN=

# Set to 1 behind HTTPS terminators.
SYNAPSENEST_SECURE_COOKIES=0

# Extra allowed Origin hosts (comma-separated), beyond built-in public hosts.
SYNAPSENEST_PUBLIC_HOSTS=

# Postgres (service is up in compose; app still uses JSON stores in phase 1)
POSTGRES_USER=synapsenest
POSTGRES_PASSWORD=change-me-before-prod
POSTGRES_DB=synapsenest
DATABASE_URL=postgres://synapsenest:change-me-before-prod@postgres:5432/synapsenest

# Host path for BusyBox runtime bind-mounts (Docker-out-of-Docker via docker.sock).
# Must be the absolute path on the Docker host — daemon resolves bind src on the host.
SYNAPSENEST_HOST_WORKSPACES_ROOT=/home/nexus/SynapseNest/data/workspaces

# Dual-read switch. Leave 0 — live app stays on JSON stores until verified.
USE_POSTGRES=0
